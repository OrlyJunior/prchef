# Optional user-global settings: copy this file to ~/.orchestrator/.env.
# The app does not load a repository-local .env file. Never commit credentials.
# API provider keys (for example OPENAI_API_KEY) belong in the process environment;
# this file does not export arbitrary credentials to providers or subprocesses.

# Trello credentials (required only when using Trello).
ORCHESTRATOR_TRELLO_API_KEY=
ORCHESTRATOR_TRELLO_TOKEN=

# Optional database override: uncomment and fill in only one of these.
# ORCHESTRATOR_DATABASE_URL=
# ORCHESTRATOR_DATABASE_PATH=

# Optional log level (defaults to INFO): uncomment and fill in to override.
# ORCHESTRATOR_LOG_LEVEL=

# YAML configuration selectors are read only from the process environment,
# not from this dotenv file. Set them in your shell if needed; precedence is
# subcommand --config, then ORCHESTRATOR_CONFIG, ORCHESTRATOR_CONFIG_PATH,
# and ORCHESTRATOR_CONFIG_FILE, in that order.
# ORCHESTRATOR_CONFIG=
# ORCHESTRATOR_CONFIG_PATH=
# ORCHESTRATOR_CONFIG_FILE=
